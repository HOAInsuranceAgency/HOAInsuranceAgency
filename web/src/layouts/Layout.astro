---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import { AGENCY } from "../../../shared/agency";
import { canonicalUrl, absoluteUrl, siteGraph } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Route path normalized by `canonicalUrl()`. */
  canonicalPath?: string;
  /** Page-specific nodes; do not pass another organization/agency node. */
  jsonLd?: Record<string, unknown>[];
  /**
   * Keep this page out of the index. Opt-in and defaults to false, so the 34
   * pages that already use this layout are unaffected. Used by state pages whose
   * content is still generic — see data/states.ts `reviewed`.
   */
  noindex?: boolean;
  /**
   * Load no analytics on this page, and send no referrer from it.
   *
   * For routes whose URL carries a secret. GA4's `config` call reports
   * `page_location`, which is the *full* URL including the query string, so a
   * page reached as `?t=<token>` would hand every live upload token to GA4,
   * Google Ads and Clarity — where anyone with report access could read one off
   * and upload into a client's account. The referrer header would leak it to any
   * third-party host the page touched, for the same reason.
   *
   * Opt-in and defaults to false so no existing page changes. Setting this is
   * not optional on a tokenised route: see pages/documents.astro.
   */
  private?: boolean;
  /**
   * Render the header solid from the top. For pages with no dark hero behind it
   * — see the Navbar's `solid` prop for why the default would be invisible.
   */
  solidNav?: boolean;
}

const {
  title,
  description,
  ogImage = "/logo.png",
  canonicalPath = "",
  jsonLd = [],
  noindex = false,
  private: isPrivate = false,
  solidNav = false,
} = Astro.props;

const canonical = canonicalUrl(canonicalPath);
const ogImageUrl = absoluteUrl(ogImage);

/** Connected agency, brand, website, page, founder and page-specific nodes. */
const graph = siteGraph({
  canonical,
  title,
  description,
  extra: jsonLd,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#1a365d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && (
      <Fragment>
        <meta name="robots" content="noindex, follow" />
        <meta name="googlebot" content="noindex, follow" />
      </Fragment>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AGENCY.brandName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {/*
      Analytics MUST stay below <title>.

      gtag's `config` call reads `document.title` synchronously to populate GA4's
      `page_title`. This block used to sit above the <title> tag, so on every page
      rendered through this layout the title had not been parsed yet, GA4 recorded an
      empty page_title, and the Pages report fell back to the raw path — the homepage
      showed as "/" rather than by name. The three templates that hand-roll their own
      <head> never had the bug because they already ordered it this way.

      Anything added here must go after the title, not before it.
    */}
    {!isPrivate && <Analytics />}
    {isPrivate && <meta name="referrer" content="no-referrer" />}
  </head>
  <body>
    <Navbar currentPath={Astro.url.pathname} solid={solidNav} />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { captureLeadAttribution } from "../lib/leadAttribution";
      captureLeadAttribution();
      /*
       * Reveal-on-scroll.
       *
       * The margin below the viewport is POSITIVE and the threshold is 0, so an
       * element starts revealing while it is still under the fold. That matters:
       * with the previous `-40px` bottom margin and a 0.12 threshold, a section
       * had to be 12% inside a viewport shrunk by 40px before it animated, so
       * the top of the next section scrolled into view still at opacity 0 and
       * read as an empty band. Revealing early means whatever is peeking above
       * the fold is already painted.
       */
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0, rootMargin: "0px 0px 25% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
