---
/**
 * Homepage hero action: a single joined control — address field and submit
 * button share one bordered group, reading as one input rather than two.
 *
 * A plain GET form, so it works with no JavaScript: submitting lands on /quote.
 *
 * THE ADDRESS FIELD IS DELIBERATELY UNNAMED — do not add a `name`.
 *
 * A named field would put the property address into `/quote?address=…`, and
 * that URL is not private: it goes into browser history, into the `Referer` of
 * anything /quote requests, into server logs, and — because quote.astro mounts
 * <Analytics /> in <head> — into the `page_location` that GA4, Google Ads and
 * Microsoft Clarity all report. A street address is personal data, and sending
 * it to Google Analytics also breaches its terms of use.
 *
 * Nothing is lost by dropping the name, because nothing consumed it: the wizard
 * collects `propertyAddress` itself on the `where` step (quote/schema.ts), and
 * `getPrefillFromUrl()` (quote/session.ts) reads only `state`.
 *
 * To actually save the visitor from retyping it, hand the value over in
 * sessionStorage from a submit handler and prefill `propertyAddress` from there
 * — same saving, no PII in a URL. That is a change to the wizard, not to this
 * hero, and it is not done yet.
 */
import { QUOTE_URL } from "../constants";

interface Props {
  placeholder?: string;
  buttonText?: string;
  /** Fee-disclosure microcopy, 24px below the control. */
  microcopy?: string;
}

const {
  placeholder = "Property address",
  buttonText = "Request Insurance Review",
  microcopy = "We charge no broker fee.",
} = Astro.props;
---

<form class="hero-lookup" action={QUOTE_URL} method="get">
  {/* No visible field label by request, so the accessible name is carried by a
      screen-reader-only label — which also keeps click-to-focus working. */}
  <label class="sr-only" for="hero-address">{placeholder}</label>
  <div class="hero-lookup__group">
    <input
      class="hero-lookup__input"
      id="hero-address"
      type="text"
      placeholder={placeholder}
      autocomplete="off"
      required
    />
    <button class="hero-lookup__btn" type="submit">{buttonText}</button>
  </div>
  <p class="hero-lookup__note">{microcopy}</p>
</form>

<!--
  The styles below are what make the field and the button read as one bar. They
  are Astro-scoped to this component and defined nowhere else, so deleting them
  leaves an unstyled native input and a default button on the hero image — which
  is exactly what a rewrite of this file did once. There is no global fallback.
-->
<style>
  .hero-lookup {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 620px;
    margin-top: 36px;
  }

  /* One seamless bar: solid white field, gold button flush against it, no outer
     border or translucency — the field reads as a single opaque control sitting
     on the image, not a glass panel. */
  .hero-lookup__group {
    display: flex;
    align-items: stretch;
    width: 100%;
    background: var(--color-white);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 12px 32px -10px rgba(9, 22, 42, 0.5);
  }

  /* Focus ring outside the bar, so the seam between field and button stays
     unbroken while the focused state is still obvious. */
  .hero-lookup__group:focus-within {
    box-shadow: 0 0 0 3px rgba(229, 193, 106, 0.55),
                0 12px 32px -10px rgba(9, 22, 42, 0.5);
  }

  .hero-lookup__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 18px 20px;
    background: transparent;
    border: none;
    color: var(--color-gray-900);
    font-family: inherit;
    font-size: 16px; /* 16px keeps iOS Safari from zooming on focus */
    line-height: 1.4;
  }

  .hero-lookup__input::placeholder {
    color: var(--color-gray-500);
  }

  .hero-lookup__input:focus {
    outline: none; /* the group carries the ring */
  }

  /* Gold fill, flush to the bar's right edge. Not `.btn` — that class brings a
     radius and a hover translate, both of which would break the seam. Navy text
     rather than white: on this gold, white does not clear contrast. */
  .hero-lookup__btn {
    flex: 0 0 auto;
    padding: 18px 32px;
    border: none;
    border-radius: 0;
    background: var(--color-gold);
    color: var(--color-navy-dark);
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.005em;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .hero-lookup__btn:hover {
    background: var(--color-gold-light);
  }

  .hero-lookup__btn:active {
    background: #cfa84f;
  }

  .hero-lookup__btn:focus-visible {
    outline: 2px solid var(--color-navy-dark);
    outline-offset: -5px;
  }

  /* The 24px gap between the control and the fee disclosure. */
  .hero-lookup__note {
    margin-top: 24px;
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
    max-width: 540px;
  }

  /* Below this the two cannot share a line without cramping both; stacking is
     the lesser evil, and they stay visually joined as one block. */
  @media (max-width: 520px) {
    .hero-lookup__group {
      flex-direction: column;
    }

    .hero-lookup__btn {
      padding: 16px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-lookup__btn {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Google Places on the hero address field, and the handoff to the wizard.
   *
   * A module rather than `is:inline`, so it imports the shared loader and the
   * shared handoff instead of carrying copies of either.
   *
   * The field is still unnamed and the form still GETs a bare /quote: the
   * address travels in sessionStorage, never in the URL. That is the whole
   * point. See lib/addressHandoff.ts.
   */
  import { attachAddressAutocomplete, loadGooglePlaces } from "../lib/googlePlaces";
  import { stashHandoff, type HandedAddress } from "../lib/addressHandoff";

  const forms = document.querySelectorAll<HTMLFormElement>("form.hero-lookup");

  forms.forEach((form) => {
    const input = form.querySelector<HTMLInputElement>(".hero-lookup__input");
    if (!input) return;

    /**
     * Set only when a visitor picks a suggestion, which is what lets the wizard
     * prefill the town, state and ZIP as well as the street line. Someone who
     * types an address and submits without choosing one hands over just the
     * text, and the wizard asks for the rest as it always did.
     */
    let chosen: HandedAddress | null = null;

    loadGooglePlaces()
      .then(() => {
        attachAddressAutocomplete(input, (place) => {
          input.value = place.formatted || place.address;
          chosen = {
            propertyAddress: place.address || place.formatted,
            city: place.city || undefined,
            state: place.state || undefined,
            zip: place.zip || undefined,
          };
        });
      })
      // Silent: a blocked script leaves a plain text box that still submits.
      .catch(() => {});

    form.addEventListener("submit", () => {
      const typed = input.value.trim();
      if (!typed) return;
      // A chosen suggestion the visitor then edited is no longer that place, so
      // the typed text wins on the street line either way.
      stashHandoff(
        chosen && chosen.propertyAddress === typed
          ? chosen
          : { propertyAddress: typed }
      );
    });
  });
</script>
