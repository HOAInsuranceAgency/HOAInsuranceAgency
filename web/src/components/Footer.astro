---
/** Site-wide legal identity, contact details, footprint and social links. */
import { SOCIAL } from "../constants";
import { AGENCY, AGENCY_FMT } from "../../../shared/agency";
---

<footer class="site-footer">
  <div class="site-footer__main">
    <a href="/" class="site-footer__logo-link">
      <img src="/logo-on-dark.png" alt="HOA Insurance Agency" class="site-footer__logo" />
    </a>
    <p class="site-footer__addr">
      <span class="site-footer__entity">{AGENCY.name}</span><br />
      {AGENCY.addressLine1}<br />{AGENCY_FMT.addressLine2}
    </p>
    <p class="site-footer__contact">
      <span class="site-footer__contact-item">
        <span class="site-footer__contact-label">General, service &amp; claims</span>
        <a href={AGENCY_FMT.emailHref}>{AGENCY.email}</a>
      </span>
      <span class="site-footer__dot">&middot;</span>
      <span class="site-footer__contact-item">
        <span class="site-footer__contact-label">Phone</span>
        <a href={AGENCY_FMT.phoneHref}>{AGENCY.phone}</a>
      </span>
    </p>
    <p class="site-footer__footprint">Licensed in {AGENCY.areaServed}.</p>
    <div class="site-footer__social">
      <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
      </a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
    </div>
  </div>
  <div class="site-footer__bottom">
    <a href="/privacy-policy/">Privacy Policy</a>
    <span class="site-footer__dot">&middot;</span>
    <a href="/terms-of-service/">Terms of Service</a>
    <span class="site-footer__dot">&middot;</span>
    <span>&copy; {new Date().getFullYear()} {AGENCY.name}</span>
    {/* ™ claims the visible mark; trade-name approval is a separate question. */}
    <span class="site-footer__mark">
      <strong>{AGENCY_FMT.brandMarkedName}</strong> is the consumer-facing brand of
      {" "}{AGENCY.name}. All insurance is placed by that licensed agency.
    </span>
  </div>
</footer>

<style>
  .site-footer {
    background: #1a365d;
    color: rgba(255, 255, 255, 0.7);
    width: 100%;
    box-sizing: border-box;
  }

  .site-footer__main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  /* No filter: the footer is always navy, so it uses the on-dark asset
     directly and keeps the gold sun that `brightness(0)` used to flatten. */
  .site-footer__logo {
    display: block;
    height: 44px;
    width: auto;
    margin-bottom: 8px;
  }

  .site-footer__addr {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .site-footer__entity {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  .site-footer__contact {
    font-size: 14px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .site-footer__contact-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .site-footer__contact-label {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }

  .site-footer__footprint {
    font-size: 13px;
    margin: 0;
    color: rgba(255, 255, 255, 0.45);
  }

  .site-footer__contact a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer__contact a:hover {
    color: #fff;
  }

  .site-footer__dot {
    color: rgba(255, 255, 255, 0.25);
  }

  .site-footer__social {
    display: flex;
    gap: 20px;
    margin-top: 8px;
  }

  .site-footer__social a {
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s;
  }

  .site-footer__social a:hover {
    color: #fff;
  }

  .site-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    max-width: 1200px;
    margin: 0 auto;
    padding: 18px 24px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .site-footer__bottom a {
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer__bottom a:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .site-footer__mark {
    flex-basis: 100%;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 768px) {
    .site-footer__main {
      padding: 48px 20px 32px;
    }
  }
</style>
