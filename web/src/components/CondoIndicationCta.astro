---
/**
 * Condominium premium-indication call to action, linking to the three-screen
 * /quote/condo/ path. Placed only where a page is about condominiums.
 *
 * `tone="dark"` sits on navy sections; the default suits white and gray ones.
 */
interface Props {
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;
---

<aside class={`ci-cta ci-cta--${tone}`} aria-label="Condominium premium indication">
  <div class="ci-cta__copy">
    <span class="ci-cta__tag">Condominium associations</span>
    <span class="ci-cta__title">Premium indication</span>
    <span class="ci-cta__line">See an estimate in about a minute.</span>
  </div>
  <a class="btn btn-gold ci-cta__btn" href="/quote/condo/">Get my indication</a>
</aside>

<style>
  .ci-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    flex-wrap: wrap;
    margin-top: 32px;
    padding: 20px 24px;
    border-radius: 16px;
    text-align: left;
  }

  .ci-cta--light {
    background: var(--brand-blend);
    box-shadow: 0 20px 44px -26px rgba(15, 23, 42, 0.55);
  }

  /* On navy: a hairline panel so it reads as an offer, not a second band. */
  .ci-cta--dark {
    border: 1px solid rgba(229, 193, 106, 0.45);
    background: rgba(255, 255, 255, 0.06);
  }

  .ci-cta__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ci-cta__tag {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }

  .ci-cta__title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-white);
  }

  .ci-cta__line {
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.78);
  }

  .ci-cta__btn {
    flex: 0 0 auto;
  }

  @media (max-width: 520px) {
    .ci-cta__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
