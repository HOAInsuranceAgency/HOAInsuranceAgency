---
import { NAV_LINKS, QUOTE_URL } from "../constants";

interface Props {
  currentPath: string;
  /**
   * Render solid from the top, rather than transparent-until-scrolled.
   *
   * The transparent state only works over a dark hero, and every page in the
   * site has one — even the legal pages use `hero--compact`. A page without one
   * gets a white logo and white links on a white background, which is to say an
   * invisible header. `/documents/` is the first such page.
   */
  solid?: boolean;
}

const { currentPath, solid = false } = Astro.props;

/* Trailing slashes are not significant, so "/contact" and "/contact/" are the
   same page. "/" normalises to itself rather than to "". */
const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const current = norm(currentPath);

/* Only the first matching link is highlighted. About Us points at the homepage,
   so comparing each link independently would mark both Home and About Us active
   on "/" — two highlighted items reads as a bug. Hash links never match. */
/* A dropdown entry has no path of its own, so it counts as active when any of
   its children is the current route. That is what lights "Coverage" on both
   /what-we-do and /condo-insurance. */
const isCurrent = (path?: string) =>
  Boolean(path) && !path!.includes("#") && norm(path!) === current;

const activeIndex = NAV_LINKS.findIndex(
  (l) => isCurrent(l.path) || (l.children ?? []).some((c) => isCurrent(c.path))
);
---

<nav
  class={"navbar" + (solid ? " navbar--scrolled" : "")}
  id="navbar"
  data-solid={solid ? "true" : undefined}
>
  <div class="navbar-inner container">
    <a href="/" class="navbar-logo">
      {/* Two files, not one filtered file. The bar is transparent over the hero
          photo and solid white once scrolled, and no single asset reads on both.
          The second is aria-hidden so the name is announced once. */}
      <img src="/logo-on-dark.png" alt="HOA Insurance Agency" class="navbar-logo__on-dark" />
      <img src="/logo.png" alt="" aria-hidden="true" class="navbar-logo__on-light" />
    </a>

    <div class="navbar-links" id="navbar-links">
      {NAV_LINKS.map((l, i) => {
        const isActive = i === activeIndex;

        if (l.children) {
          return (
            <div class={"navbar-group" + (isActive ? " navbar-group--active" : "")}>
              <button
                type="button"
                class="navbar-link navbar-group__toggle"
                aria-expanded="false"
                aria-controls={`navbar-submenu-${i}`}
              >
                {l.label}
                <svg class="navbar-group__chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="navbar-group__menu" id={`navbar-submenu-${i}`} hidden>
                {l.children.map((c) => {
                  const childActive = isCurrent(c.path);
                  return (
                    <a
                      href={c.path}
                      class={"navbar-group__item" + (childActive ? " navbar-group__item--active" : "")}
                      aria-current={childActive ? "page" : undefined}
                    >
                      {c.label}
                    </a>
                  );
                })}
              </div>
            </div>
          );
        }

        return (
          <a
            href={l.path}
            class={"navbar-link" + (isActive ? " navbar-link--active" : "")}
            aria-current={isActive ? "page" : undefined}
          >
            {l.label}
          </a>
        );
      })}
      <a href={QUOTE_URL} class="btn btn-gold navbar-cta">
        Request Insurance Review
      </a>
    </div>

    <button
      type="button"
      class="navbar-hamburger"
      id="navbar-hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navbar-links"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>
</nav>

<script>
  import { initializeNavbar } from "../lib/navbar";

  const navbar = document.getElementById("navbar");
  if (navbar) initializeNavbar(navbar);
</script>

<style is:global>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: var(--nav-height);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .navbar--scrolled,
  .navbar--open {
    background: #ffffff !important;
    border-bottom-color: var(--color-gray-200) !important;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* `line-height: 0` kills the descender gap the inline image would otherwise
     add below itself, which is what keeps the bar's two halves aligned. */
  .navbar-logo {
    position: relative;
    display: block;
    line-height: 0;
  }

  .navbar-logo img {
    display: block;
    height: 44px;
    width: auto;
    transition: opacity 0.3s ease;
  }

  /* The light version sits exactly on top of the dark one and fades in as the
     bar turns solid, so the swap rides the navbar's own transition rather than
     snapping a frame ahead of it. `top`/`left` rather than `inset: 0`, which
     would stretch it and ignore the height. */
  .navbar-logo__on-light {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .navbar--scrolled .navbar-logo__on-light,
  .navbar--open .navbar-logo__on-light {
    opacity: 1;
  }

  .navbar--scrolled .navbar-logo__on-dark,
  .navbar--open .navbar-logo__on-dark {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-logo img {
      transition: none;
    }
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .navbar-link {
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .navbar-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .navbar--scrolled .navbar-link {
    color: var(--color-gray-600);
  }

  .navbar--scrolled .navbar-link:hover {
    color: var(--color-gray-900);
    background: var(--color-gray-50);
  }

  .navbar-link--active {
    color: #ffffff;
    font-weight: 600;
  }

  .navbar--scrolled .navbar-link--active {
    color: var(--color-accent);
  }

  .navbar-cta {
    margin-left: 8px;
    padding: 10px 20px;
    font-size: 14px;
  }

  .navbar-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .navbar--scrolled .hamburger-bar,
  .navbar--open .hamburger-bar {
    background: var(--color-gray-700);
  }

  .hamburger-bar--open:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .hamburger-bar--open:nth-child(2) {
    opacity: 0;
  }

  .hamburger-bar--open:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }


  /* The disclosure button controls visibility and keyboard access together. */
  .navbar-group {
    position: relative;
  }

  .navbar-group__toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .navbar-group__chev {
    transition: transform 0.2s ease;
  }

  .navbar-group__toggle[aria-expanded="true"] .navbar-group__chev {
    transform: rotate(180deg);
  }

  .navbar-group__menu {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 10px;
    min-width: 232px;
  }

  .navbar-group__menu[hidden] {
    display: none;
  }

  .navbar-group__toggle:focus-visible,
  .navbar-hamburger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .navbar-group__item {
    display: block;
    padding: 11px 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-gray-700);
    background: var(--color-white);
    text-decoration: none;
    border: 1px solid var(--color-gray-200);
    border-bottom: 0;
  }

  .navbar-group__item:first-of-type {
    border-radius: 10px 10px 0 0;
  }

  .navbar-group__item:last-of-type {
    border-bottom: 1px solid var(--color-gray-200);
    border-radius: 0 0 10px 10px;
  }

  .navbar-group__item:hover,
  .navbar-group__item:focus-visible {
    background: var(--color-gray-50);
    color: var(--color-navy);
  }

  .navbar-group__item--active {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* The group label follows the same light/dark treatment as a plain nav link. */
  .navbar-group--active .navbar-group__toggle {
    color: #ffffff;
    font-weight: 600;
  }

  .navbar--scrolled .navbar-group--active .navbar-group__toggle {
    color: var(--color-accent);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {

    .navbar-group {
      width: 100%;
    }

    .navbar-group__toggle {
      width: 100%;
      justify-content: flex-start;
      font-size: 18px;
      padding: 14px 16px;
      color: var(--color-gray-700) !important;
    }

    .navbar-group__menu {
      position: static;
      padding-top: 0;
      padding-left: 12px;
      min-width: 0;
    }

    .navbar-group__item {
      font-size: 16px;
      padding: 12px 16px;
      background: none;
      border: 0 !important;
      border-radius: 0 !important;
    }

    .navbar-hamburger {
      display: flex;
    }

    .navbar-links {
      position: fixed !important;
      top: var(--nav-height) !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: calc(100vh - var(--nav-height)) !important;
      height: calc(100dvh - var(--nav-height)) !important;
      z-index: 10000 !important;
      background: #ffffff !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: stretch !important;
      padding: 32px 24px !important;
      gap: 4px !important;
      overflow-y: auto !important;
      visibility: hidden;
      transform: translateY(-20px);
      opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .navbar-links--open {
      visibility: visible !important;
      transform: translateY(0) !important;
      opacity: 1 !important;
      transition: visibility 0s, transform 0.3s ease, opacity 0.3s ease !important;
    }

    .navbar-links .navbar-link {
      font-size: 18px;
      padding: 14px 16px;
      color: var(--color-gray-700) !important;
    }

    .navbar-links .navbar-link:hover {
      color: var(--color-gray-900) !important;
      background: var(--color-gray-50) !important;
    }

    .navbar-links .navbar-link--active {
      color: var(--color-accent) !important;
    }

    .navbar-links .navbar-cta {
      margin-left: 0;
      margin-top: 16px;
      text-align: center;
      justify-content: center;
      font-size: 16px;
      padding: 16px 24px;
    }
  }
</style>
