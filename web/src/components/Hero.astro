---
import "./Hero.css";

interface Props {
  title: string;
  subtitle?: string;
  backgroundImage: string;
  /** Optional short line under the H1, above the subtitle. */
  note?: string;
  backgroundVideo?: string;
  /** Start the video on load with no play/pause control (homepage, why-choose-us). */
  autoplayVideo?: boolean;
  ctaText?: string;
  ctaHref?: string;
  compact?: boolean;
  /** Content-height hero with tighter spacing, well under half the viewport. */
  short?: boolean;
  eyebrow?: string;
}

const { title, subtitle, note, backgroundImage, backgroundVideo, autoplayVideo, ctaText, ctaHref, compact, short, eyebrow } = Astro.props;

// Action-slot heroes keep the lookup form above the fold.
const hasAction = Astro.slots.has("action");
---

<section
  class={"hero" + (compact ? " hero--compact" : "") + (hasAction ? " hero--action" : "") + (short ? " hero--short" : "")}
  data-hero
>
  <img
    class="hero-poster"
    src={backgroundImage}
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
    aria-hidden="true"
  />
  {backgroundVideo && (
    <>
      <video
        class="hero-video"
        data-hero-video
        data-src={backgroundVideo}
        data-autoplay={autoplayVideo ? "" : undefined}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
      />
      {!autoplayVideo && (
        <button type="button" class="hero-motion-toggle" data-hero-video-toggle hidden>
          Play background video
        </button>
      )}
    </>
  )}
  <div class="hero-overlay"></div>
  <div class="hero-content container">
    {eyebrow && <span class="hero-eyebrow">{eyebrow}</span>}
    <h1 class="hero-title">{title}</h1>
    {note && <p class="hero-note">{note}</p>}
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {hasAction ? (
      <slot name="action" />
    ) : (
      ctaText && ctaHref && (
        <a href={ctaHref} class="btn btn-gold hero-cta">{ctaText}</a>
      )
    )}
  </div>
</section>

<script>
  import { initializeHeroVideo } from "../lib/hero-video";

  document.querySelectorAll<HTMLElement>("[data-hero]").forEach(initializeHeroVideo);
</script>
