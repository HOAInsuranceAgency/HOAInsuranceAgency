---
/**
 * Why choose us.
 *
 * Aligned to the homepage and /what-we-do: same hero treatment with the address
 * lookup, same section furniture from global.css, and sections 04 and 05 reuse
 * the homepage's own process stages and carrier wall from shared data files, so
 * the three pages state those once and state them identically.
 *
 *   01 hero            02 the practice + four reasons
 *   03 the offer       04 Review. Compare. Place. Record.
 *   05 Our markets     06 contact (matching /contact)
 */
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HeroLookup from "../components/HeroLookup.astro";
import { ContactForm } from "../components/ContactForm";
import { STAGES } from "../data/process";
import { MARKETS } from "../data/markets";
import { QUOTE_URL } from "../constants";
import { AGENCY } from "../../../shared/agency";
import "./WhyChooseUs.css";

/**
 * Meta description.
 *
 * The phone number and the brand name were typed into this string by hand, and
 * this was the last hand-typed phone number left in the pages directory —
 * QuoteApp.tsx already carries the comment describing the same drift being
 * corrected there. A meta description is the worst place for a stale number: it
 * is not visible while editing the page, so nobody notices it still says the old
 * one, but it is exactly what a searcher reads and dials before ever reaching
 * the site. Both values now come from shared/agency.ts, which is the single
 * source of truth for them.
 *
 * Concatenated rather than templated: the Astro compiler mis-parses a template
 * literal nested inside a `${}` in frontmatter and fails the build with a
 * misleading "Expected > but found lang".
 */
const metaDescription =
  "HOA-only focus, coordinated coverage systems, defensible renewal strategies, and HO-6 " +
  "programs that reduce board headaches. See why associations choose " +
  AGENCY.brandName +
  ". Free review — " +
  AGENCY.phone +
  ".";

/* 02 — Four reasons. Each carries a claim, a short argument, and the specifics
   that make the claim checkable rather than assertive. */
const DIFFERENTIATORS = [
  {
    num: "01",
    title: "Community association focus",
    /* "better submissions ... sharper renewal conversations and fewer gaps left
       open" was three comparative claims with nothing to compare against, and
       the last of them read as an outcome we control. What working one class
       actually produces is a submission an underwriter can read and a renewal
       conversation that starts from the policy — both describable, neither a
       promise about what the coverage will do. */
    desc: "Our association-focused process produces a submission an underwriter can read quickly, a renewal conversation that starts from the policy itself, and gaps that get named rather than left unmentioned.",
    bullets: [
      "Condominium associations and condominium trusts",
      "Homeowners associations",
      "Property managers running multiple associations",
      "Unit owners whose HO-6 has to match the master policy",
    ],
  },
  {
    num: "02",
    title: "One program, not six purchases",
    desc: "Property, liability, umbrella, D&O, crime and ordinance or law are placed as one system, so the limits and deductibles agree with each other.",
    bullets: [
      "Property, general liability and umbrella as one tower",
      "D&O and crime and fidelity written together",
      "HO-6 aligned to the master policy structure",
      "Deductibles and assessments explained to owners in advance",
    ],
  },
  {
    num: "03",
    title: "A renewal a board can defend",
    desc: "Every recommendation comes with the reasoning behind it, in writing, ready to be read at a meeting and filed with the minutes.",
    bullets: [
      "What the current policy does and does not cover",
      "Why each limit and deductible was set where it was",
      "What the market returned, option by option",
      "A written recommendation, not a verbal one",
    ],
  },
  {
    num: "04",
    title: "HO-6 coordinated to the master policy",
    /* Previously "so the gap between them does not land on a resident", which
       promised a post-loss result no agency can guarantee — whether a resident
       ends up paying is decided by the two policies' terms and the adjusters,
       not by who placed them. Placing both sides and writing the boundary down
       is the part we actually do, so that is what the sentence now claims. */
    desc: "Uncoordinated owner policies are where post-loss disputes begin. We place both sides and set out in writing where one ends and the other starts, so the gap is found before a loss rather than argued over after one.",
    bullets: [
      "The master policy structure identified and explained",
      "Owners told what they are responsible for",
      "HO-6 written against the actual policy, not a template",
    ],
  },
];
---

<Layout
  title="Why Choose HOA Insurance Agency — Specialists in HOA & Condo Insurance"
  description={metaDescription}
  canonicalPath="/why-choose-us/"
>
  {/* ═══ 01 · Hero — same treatment as the homepage ═════════════════ */}
  <Hero
    eyebrow="ProtectMyHOA™"
    title="Why Choose HOA Insurance Agency"
    subtitle="HOA boards need more than a generic insurance quote. Associations face shared ownership, shared liability and shared governance, alongside increasingly complex underwriting requirements."
    backgroundImage="/images/hero-people.jpg"
    backgroundVideo="/images/hero-video.mp4"
  >
    <HeroLookup slot="action" />
  </Hero>

  <div class="wcu">
    {/* ═══ 02 · The practice + four reasons ═════════════════════════ */}
    <section class="section" aria-labelledby="practice-h">
      <div class="container">
        <div class="sec-head sec-head--center">
          <p class="eyebrow">The practice</p>
          <h2 class="section-title" id="practice-h">
            A practice focused on community associations
          </h2>
          <p class="section-subtitle">
            Master policies and HO-6, placed together, so a board can see how the decisions fit
            and explain them afterwards.
          </p>
          <div class="wwd-cta wwd-cta--center">
            <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
            <span class="wwd-cta__note">Free review. No broker fee, now or at renewal.</span>
          </div>
        </div>

        {/* Numbered because the four build on each other: focus produces the
            program, the program produces the defensible renewal, and the
            renewal is what makes HO-6 coordination possible. */}
        <ol class="wcu-grid">
          {DIFFERENTIATORS.map((d) => (
            <li class="wcu-card">
              <span class="wcu-card__num" aria-hidden="true">{d.num}</span>
              <h3 class="wcu-card__title">{d.title}</h3>
              <p class="wcu-card__desc">{d.desc}</p>
              <ul class="wcu-card__list">
                {d.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ═══ 03 · The offer ══════════════════════════════════════════ */}
    <section class="section section--navy" aria-labelledby="offer-h">
      <div class="container">
        <div class="wcu-offer">
          <div class="wcu-offer__lead">
            <p class="eyebrow eyebrow--gold">The offer</p>
            <h2 class="section-title wcu-offer__title" id="offer-h">
              An insurance partner built for association renewals and HO-6 coordination
            </h2>
            <p class="wcu-offer__body">
              Send us the current policy and the renewal date. We come back with the markets
              approached, what each returned, and a written recommendation your board can file
              with its minutes.
            </p>
          </div>
          <div class="wcu-offer__actions">
            <a href={QUOTE_URL} class="btn btn-gold">Request Insurance Review</a>
            <a href="/what-we-do/" class="btn btn-outline">See our HOA coverages</a>
            {/* The one qualifier this page carries, placed where the offer is
                made rather than repeated under every paragraph. Same sentence
                the rest of the site uses, so it reads as house voice. */}
            <p class="wcu-offer__note">
              No broker fee. No obligation. Coverage is subject to underwriting, policy terms,
              and eligibility.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ═══ 04 · Process — shared with the homepage ═════════════════ */}
    <section class="section" aria-labelledby="stages-h">
      <div class="container">
        <div class="sec-head sec-head--center">
          <p class="eyebrow">The process</p>
          <h2 class="section-title" id="stages-h">Review. Compare. Place. Record.</h2>
          <p class="section-subtitle">
            Four stages, in order, on a schedule the board can hold us to.
          </p>
        </div>
        <ol class="stage-grid">
          {STAGES.map((s) => (
            <li class="stage-card reveal">
              <span class="stage-num">{s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
        <div class="wwd-cta wwd-cta--center">
          <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
          {/* Was "Most reviews start the same week." Nothing in the business
              measures that, and an agency formed in December 2025 has no volume
              of completed reviews to draw a "most" from. The replacement says
              what stage one needs instead, which is the same invitation without
              the statistic. */}
          <span class="wwd-cta__note">Stage one starts with your current policy.</span>
        </div>
      </div>
    </section>

    {/* ═══ 05 · Our markets — shared with the homepage ═════════════ */}
    <section class="section section--alt" aria-labelledby="markets-h">
      <div class="container">
        <div class="sec-head sec-head--center">
          <p class="eyebrow">Our markets</p>
          <h2 class="section-title" id="markets-h">Markets a board will recognize</h2>
          <p class="section-subtitle">
            Direct appointments with twelve markets — national insurers alongside the specialists.
          </p>
        </div>

        {/* The list renders twice and the track animates to -50%, so the second
            copy is where the first began when the loop resets. The duplicate is
            aria-hidden so assistive tech reads twelve carriers, not twenty-four. */}
        <div class="carrier-marquee">
          <ul class="carrier-track">
            {MARKETS.map((m) => (
              <li class="carrier">
                <img
                  class="carrier__logo"
                  src={`/images/carriers/${m.slug}.png`}
                  alt={m.name}
                  width="240"
                  height="120"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
            {MARKETS.map((m) => (
              <li class="carrier" aria-hidden="true">
                <img
                  class="carrier__logo"
                  src={`/images/carriers/${m.slug}.png`}
                  alt=""
                  width="240"
                  height="120"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        </div>

        <p class="carrier-note">
          One submission goes out to the markets that write it. Carrier availability varies by
          state, association type and risk profile, and not every market is approached on every
          placement.
        </p>

        <div class="wwd-cta wwd-cta--center">
          <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
          <span class="wwd-cta__note">See what each market returned, side by side.</span>
        </div>
      </div>
    </section>

    {/* ═══ 06 · Contact — same treatment as /contact ═══════════════ */}
    <ContactForm showClaims client:visible />
  </div>
</Layout>
