---
/** Condo product page. Keep the FAQ copy and its page-bound schema together. */
import Layout from "../layouts/Layout.astro";
import CondoIndicationCta from "../components/CondoIndicationCta.astro";
import Hero from "../components/Hero.astro";
import HeroLookup from "../components/HeroLookup.astro";
import { ContactForm } from "../components/ContactForm";
import AgencyStandards from "../components/AgencyStandards.astro";
import { QUOTE_URL } from "../constants";
import { canonicalUrl, faqPageSchema } from "../lib/seo";
import "./WhatWeDo.css";
// Condo-scoped overrides follow the shared coverage styles.
import "./CondoInsurance.css";

const PAGE_URL = canonicalUrl("/condo-insurance/");

/** Coverage summaries; issued forms, endorsements, limits and exclusions control. */
const MASTER_COVERAGES = [
  { title: "Commercial property", icon: "building", covers: "Shared buildings and common elements after a covered loss, typically at replacement cost. Equipment breakdown for boilers, elevators and HVAC can be added.", check: "Valuation terms and whether the building limit reflects today’s rebuilding cost." },
  { title: "General liability", icon: "shield", covers: "The association’s liability and defense costs for covered injury or property-damage claims from common property and operations.", check: "Limits against the condominium’s amenities, size and exposure." },
  { title: "Umbrella / excess liability", icon: "umbrella", covers: "Additional limits above specified primary liability policies.", check: "Which underlying policies it sits over, and the excess-policy terms." },
  { title: "Directors & officers liability", icon: "briefcase", covers: "Board members and the association against covered governance claims, including defense costs.", check: "Exclusions, and prior-acts terms when changing carriers." },
  { title: "Crime and fidelity", icon: "lock", covers: "Theft of association funds by employees or volunteers. Third-party theft may need additional coverage.", check: "The limit against funds held, including reserves, and lender guidelines." },
  { title: "Ordinance or law", icon: "scale", covers: "Certain extra costs of rebuilding to current code after a covered loss.", check: "Each part carries its own limit, which matters most in older buildings." },
  { title: "Workers compensation", icon: "worker", covers: "Employee injury exposure, as required by state law.", check: "Staffing and contractor arrangements, including uninsured contractors." },
];

/** Common review issues, not predictions about a particular claim or project. */
const COMMON_ISSUES = [
  { title: "The board isn’t sure which master policy form applies", desc: "Bare walls, single entity and all-in (also called walls-in) forms draw the unit boundary differently. We compare your condominium declaration and applicable state law with the issued policy and endorsements, because the label alone doesn’t establish coverage." },
  { title: "The per-unit deductible may affect financing", desc: "Some loan programs limit the deductible a condominium can carry. A deductible outside those limits can affect owners’ ability to sell or refinance, so we review it against the project and loan requirements that apply." },
  { title: "Owners don’t know what they could be assessed", desc: "After a large loss, a condo association may be able to pass the deductible or a shortfall to owners as a special assessment. We help the board identify that exposure and communicate it before a claim, not after." },
  { title: "The building limit predates today’s costs", desc: "Condo building Insurance written on a replacement-cost basis still has valuation conditions and limits. We review current rebuilding estimates against the issued coverage to flag potential shortfalls." },
  { title: "Ordinance or law limits are too low for an older building", desc: "Rebuilding to current code can add significant cost after a covered loss, especially in an older condominium. We check whether each part of ordinance or law coverage carries a realistic limit." },
  { title: "Fidelity coverage falls below lender minimums", desc: "Lenders may require crime and fidelity coverage based on the funds a condominium association holds, including reserves. We compare your limit with the funds on hand and the lender guidelines that apply." },
];

/** Typical structures; the actual documents, law and policy terms control. */
const POLICY_TYPES = [
  { name: "Bare walls", covers: "Structure and common elements", stops: "Interior walls, fixtures, cabinets, flooring, improvements and belongings", owner: "Most" },
  { name: "Single entity", covers: "Structure, common elements, and original fixtures and finishes", stops: "Owner upgrades and improvements, belongings and personal liability", owner: "Some" },
  { name: "All-in (walls-in)", covers: "Structure, common elements, original finishes and usually owner improvements", stops: "Belongings and personal liability", owner: "Least" },
];

const AUDIENCES = [
  { icon: "board",     title: "Boards & trustees",     cta: "Request a board review",       href: QUOTE_URL },
  { icon: "manager",   title: "Property managers",     cta: "Talk to us about a portfolio", href: "/contact/" },
  { icon: "developer", title: "Developers & sponsors", cta: "Discuss a new project",        href: "/contact/" },
  { icon: "owner",     title: "Unit owners",           cta: "Get HO-6 coverage",            href: QUOTE_URL },
];

/** Shared by the visible accordion and structured data. */
const FAQS = [
  { q: "How do we find out whether our condominium is bare walls, single entity or all-in?", a: "We compare the governing documents and applicable law with the issued master policy, forms and endorsements. These labels describe typical arrangements, but do not replace the actual terms, limits and exclusions. A certificate is not a substitute for that review. We identify the unit boundary and any mismatch in writing so the board and owners can review the master policy and HO-6 together." },
  { q: "A pipe failed and damaged three units. Who pays the deductible?", a: "A deductible may apply per occurrence or per unit. Whether any amount can be allocated to an owner depends on applicable law, the governing documents, the policy's allocation provisions and the facts of the loss. A loss below the master deductible does not automatically become an owner assessment. HO-6 loss-assessment coverage may respond only if the cause and assessment are covered, subject to its own terms, exclusions and limits, including any special limit for a master-policy deductible. We review the actual policies before drawing a conclusion." },
  { q: "Can our Insurance affect owners' mortgage options?", a: "Yes. Insurance can affect whether a condominium meets a particular lender's or loan program's project requirements. Depending on the project and review type, those requirements may address replacement-cost coverage, deductibles, fidelity or crime coverage, and reserve funding. They are not identical across all mortgages, and Insurance is only part of project eligibility. We check the Insurance against the requirements identified for the review and flag questions for the lender, which determines loan eligibility." },
];

const faqJsonLd = faqPageSchema(PAGE_URL, FAQS);
---

<Layout
  title="Condominium Association Insurance — ProtectMyHOA"
  description="Condo master policy and HO-6 placed as one programme, with a written record the board can file. Bare walls, single entity and all-in explained, and warrantability checked."
  canonicalPath="/condo-insurance/"
  jsonLd={[faqJsonLd]}
>
  {/* ═══ Hero — same treatment as /what-we-do ═══════════════════════ */}
  <Hero
    eyebrow="Condominium Association Insurance · Licensed Nationwide"
    title="Condo Association Insurance for Condominium Boards and Managers."
    subtitle="Insurance Built for Associations™. We place your condominium’s master policy, from condo building Insurance to liability, D&O and crime, with Insurance companies that write condo risks, and document every recommendation so your board can stand behind it."
    backgroundImage="/images/modern-building.jpg"
    short
  >
    <HeroLookup
      slot="action"
      placeholder="Condominium address"
      buttonText="Estimate my condo premium"
      microcopy="Licensed nationwide · No broker fee · Non-binding indication, subject to underwriting"
    />
  </Hero>

  {/* Keep condo-specific styling scoped away from the HOA coverage page. */}
  <div class="wwd condo">
  {/* ═══ 01 · What a condo master policy is ══════════════════════ */}
  <section class="section" id="master-policy" aria-labelledby="define-h">
    <div class="container">
      <div class="condo-lead reveal">
        <p class="eyebrow">The master policy</p>
        <h2 class="section-title" id="define-h">What is a condo master policy?</h2>
        <p class="wwd-lead">
          A condo master policy, also called condominium master Insurance, is the association’s
          own policy, paid for through owners’ dues. It can cover the condominium’s shared
          buildings and common elements, the association’s legal liability, and theft of
          association funds. The board purchases it on the association’s behalf and is
          responsible for reviewing its limits, deductibles and exclusions each year.
        </p>
        <p class="wwd-lead">
          Where it stops deserves a closer look. Your condominium declaration, bylaws and
          applicable state law set who is responsible for what, while the issued policy and its
          endorsements define what is actually covered. Anything the master policy leaves out
          typically falls to unit owners and their own Insurance, so a mismatch between the
          documents and the policy can leave a gap.
        </p>
        <p class="wwd-lead">
          That’s where we come in. Our licensed agents read your condo association master
          Insurance policy against your governing documents, address the gaps we can at renewal,
          and put our reasoning in writing so your board can explain the decision a year from now.
        </p>
        <div class="condo-lead__cta condo-lead__cta--center">
          <a href={QUOTE_URL} class="btn btn-navy">Request Insurance Review</a>
          <span class="condo-lead__note">No broker fee</span>
        </div>
        <CondoIndicationCta />
      </div>
    </div>
  </section>

  {/* ═══ Our standards — shared with /what-we-do ═══════════════════ */}
  <AgencyStandards />

  {/* ═══ 02 · Coverages ════════════════════════════════════════════ */}
  <section class="section" id="coverage" aria-labelledby="cov-h">
    <div class="container">
      <div class="sec-head sec-head--center reveal">
        <p class="eyebrow">Coverage</p>
        <h2 class="section-title" id="cov-h">What does a condo association master policy cover?</h2>
        <p class="section-subtitle">
          Bound is not the same as covered. Property, liability, umbrella, D&amp;O, crime and
          ordinance-or-law should be reviewed as one program, even when written on separate
          policies. We compare their limits, deductibles and exclusions for gaps.
        </p>
      </div>
      <img
        class="condo-band reveal"
        src="/images/condo-boardroom.jpg"
        alt="Insurance producer reviewing a condominium master policy with two association board members"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />

      {/* One hairline table, a row per coverage: what it covers, and what we
           check on review. Scans in one pass instead of seven paragraphs. */}
      <div class="cov-table reveal" role="table" aria-label="Condo master policy coverages">
        <div class="cov-table__head" role="row">
          <span role="columnheader">Coverage</span>
          <span role="columnheader">What it covers</span>
          <span role="columnheader">What we check</span>
        </div>
        {MASTER_COVERAGES.map((c) => (
          <div class="cov-table__row" role="row">
            <div class="cov-table__name" role="rowheader">
              <span class="cov-table__mark" aria-hidden="true">
                {c.icon === "building" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01"/><path d="M10 21v-3h4v3"/></svg>}
                {c.icon === "shield" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 9.5-8 10-4.5-.5-8-5-8-10V6l8-4z"/></svg>}
                {c.icon === "umbrella" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="M2 12a10 10 0 0120 0H2z"/><path d="M12 12v7a3 3 0 01-6 0"/></svg>}
                {c.icon === "briefcase" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/><path d="M3 13h18"/></svg>}
                {c.icon === "lock" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>}
                {c.icon === "scale" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M5 7h14"/><path d="M5 7l-2 6a4 4 0 008 0L9 7"/><path d="M17 7l-2 6a4 4 0 008 0l-2-6"/></svg>}
                {c.icon === "worker" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0118 0"/><path d="M2 12h20"/><path d="M9 12V6.5a3 3 0 016 0V12"/><path d="M5 16.5A7.5 7.5 0 0112 21a7.5 7.5 0 017-4.5"/></svg>}
            </span>
              <h3>{c.title}</h3>
            </div>
            <p class="cov-table__covers" role="cell"><span class="cov-table__label">What it covers</span>{c.covers}</p>
            <p class="cov-table__check" role="cell"><span class="cov-table__label">What we check</span>{c.check}</p>
          </div>
        ))}
      </div>
      <p class="cov-note">
        Coverage summaries are subject to the issued policy forms, endorsements, limits and
        exclusions. Earthquake and flood are reviewed alongside the program where needed;
        availability depends on the condominium and market.
      </p>
      <CondoIndicationCta />
      <div class="condo-lead__cta condo-lead__cta--center">
        <a href={QUOTE_URL} class="btn btn-navy">Request Insurance Review</a>
        <span class="condo-lead__note">No broker fee</span>
      </div>
    </div>
  </section>

  {/* ═══ 03 · What we find ═════════════════════════════════════════ */}
  <section class="section section--navy" id="what-we-find" aria-labelledby="issues-h">
    <div class="container">
      <div class="sec-head sec-head--center reveal">
        <p class="eyebrow eyebrow--gold">What we find</p>
        <h2 class="section-title wwd-invert" id="issues-h">
          Every condo Insurance gap has a name. We find it before the adjuster does.
        </h2>
        <p class="section-subtitle wwd-invert-sub">
          Six issues we check on every first review of a condominium association’s Insurance.
          Each one can be considered now rather than after a claim.
        </p>
      </div>
      <div class="issues-acc reveal">
        {COMMON_ISSUES.map((iss, i) => (
          <details class="issue-acc">
            <summary>
              <span class="issue-acc__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="issue-acc__title">{iss.title}</span>
              <span class="issue-acc__chev" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </span>
            </summary>
            <p>{iss.desc}</p>
          </details>
        ))}
      </div>
      <div class="issues-foot">
        <p class="issues-foot__text">
          We’ll tell you which of the six apply to your condominium and put the findings in
          writing. Don’t just renew. Review.
        </p>
        <a href={QUOTE_URL} class="btn btn-gold issues-foot__cta">Start my condominium review</a>
      </div>
    </div>
  </section>

  {/* ═══ 04 · Where the master policy stops ════════════════════════ */}
  <section class="section" id="who-pays" aria-labelledby="stops-h">
    <div class="container">
      <div class="sec-head sec-head--center reveal">
        <p class="eyebrow">Who pays</p>
        <h2 class="section-title" id="stops-h">Bare walls, single entity or all-in: who pays for what in a condominium</h2>
        <p class="section-subtitle">
          Your condo master policy form decides where the association’s coverage ends and each
          owner’s begins. These are typical descriptions, not coverage guarantees; your
          condominium declaration, state law and the issued policy control.
        </p>
      </div>

      <div class="types-table-wrap reveal">
        <table class="types-table">
          <thead>
            <tr>
              <th scope="col">Master policy form</th>
              <th scope="col">The association typically insures</th>
              <th scope="col">Typically left to the owner</th>
              <th scope="col" class="types-table__owner-col">Owner carries</th>
            </tr>
          </thead>
          <tbody>
            {POLICY_TYPES.map((t) => (
              <tr>
                <th scope="row">{t.name}</th>
                <td>{t.covers}</td>
                <td>{t.stops}</td>
                <td class="types-table__owner-col"><span class="owner-pill">{t.owner}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="stops-pair reveal">
        <div class="stops-item">
          <h3>Warrantability and lender requirements</h3>
          <p>
            Lenders following Fannie Mae, Freddie Mac or FHA guidelines may review a
            condominium’s replacement-cost coverage, deductibles, fidelity coverage and reserves
            before approving a loan. Requirements vary and can change. We flag Insurance
            questions for the board and lender; the lender decides loan eligibility.
          </p>
        </div>
        <div class="stops-item">
          <h3>The deductible and the assessment</h3>
          <p>
            The deductible is the part of a covered loss the insurer doesn’t pay. Depending on
            state law, the declaration and the facts of the loss, the association may allocate
            it, or another shortfall, to owners as an assessment. The premium is what you
            budget. The deductible is what you risk.
          </p>
        </div>
      </div>

      <div class="stops-foot">
        <p class="stops-foot__text">
          On every review, we map your condominium declaration against the issued policy,
          confirm where the unit boundary falls, and record any mismatch for the board.
        </p>
        <a href={QUOTE_URL} class="btn btn-primary stops-foot__cta">Confirm my condo policy form</a>
      </div>
    </div>
  </section>

  {/* ═══ 05 · Who we work with ══════════════════════════════════════ */}
  <section class="section" id="who-we-serve" aria-labelledby="types-h">
    <div class="container">
      <div class="sec-head sec-head--center reveal">
        <p class="eyebrow">Who we serve</p>
        <h2 class="section-title" id="types-h">Who we work with</h2>
        <p class="section-subtitle">
          Four groups, each needing something different from the same placement. Licensed in
          all 50 states and the District of Columbia. Coverage availability depends on the
          association, state and carrier.
        </p>
      </div>
      <div class="aud-grid reveal">
        {AUDIENCES.map((a) => (
          <div class="aud-card">
            <span class="aud-card__mark" aria-hidden="true">
              {a.icon === "board" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 19v-1.4a3.4 3.4 0 00-3.4-3.4H7.4A3.4 3.4 0 004 17.6V19"/><circle cx="9.75" cy="7.6" r="3.4"/><path d="M16.6 11.1a3.2 3.2 0 000-6.3"/><path d="M20 19v-1.4a3.3 3.3 0 00-2.3-3.1"/></svg>}
              {a.icon === "manager" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01"/><path d="M10 21v-3h4v3"/></svg>}
              {a.icon === "developer" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M3 10h6M15 9h6M15 14h6"/></svg>}
              {a.icon === "owner" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.6L12 3l9 7.6"/><path d="M5.4 9.6V20h13.2V9.6"/><path d="M10 20v-5.2h4V20"/></svg>}
            </span>
            <h3>{a.title}</h3>
            <a href={a.href} class="text-link aud-card__cta">{a.cta} &gt;</a>
          </div>
        ))}
      </div>
      <div class="wwd-cta wwd-cta--center">
        <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
        <span class="wwd-cta__note">
          A quote is a number. A review is an answer.
        </span>
      </div>
    </div>
  </section>

  {/* ═══ 06 · FAQ ══════════════════════════════════════════════════ */}
  <section class="section section--alt" id="faq" aria-labelledby="faq-h">
    <div class="container">
      <div class="sec-head sec-head--center reveal">
        <p class="eyebrow">Questions</p>
        <h2 class="section-title" id="faq-h">Condo Insurance questions</h2>
      </div>
      <div class="faq-list reveal">
        {FAQS.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="wwd-cta wwd-cta--center">
        <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
        <a href="/contact/" class="text-link">Or ask us a question &gt;</a>
      </div>
    </div>
  </section>

  <ContactForm showClaims client:visible />
  </div>
</Layout>
