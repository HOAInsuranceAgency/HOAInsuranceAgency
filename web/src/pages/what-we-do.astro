---
/** HOA insurance product page. FAQ copy also feeds the FAQPage node. */
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HeroLookup from "../components/HeroLookup.astro";
import { ContactForm } from "../components/ContactForm";
import { QUOTE_URL } from "../constants";
import { canonicalUrl, faqPageSchema } from "../lib/seo";
import { AGENCY } from "../../../shared/agency";
import "./WhatWeDo.css";

/** Canonical shared by the page and its FAQ node. */
const PAGE_URL = canonicalUrl("/what-we-do/");

/* 01 — What the master policy responds to. Definition first, four objects. */
const RESPONDS_TO = [
  { title: "The shared buildings", desc: "Roofs, structure, common elements and the shared systems inside them." },
  { title: "The association's liability", desc: "Claims arising from the common areas and from the association's operations." },
  { title: "The funds it holds", desc: "Reserves and operating accounts, against theft and fraud." },
  { title: "The decisions its board makes", desc: "Allegations about governance, enforcement and the choices trustees make." },
];

/** Coverage summaries; issued terms, exclusions and endorsements control. */
const MASTER_COVERAGES = [
  { title: "Commercial Property", icon: "building", desc: "Rebuilds the shared buildings and common elements after a covered loss, typically at replacement cost rather than depreciated value. Equipment breakdown for shared boilers, elevators and HVAC can be written alongside it." },
  { title: "General Liability", icon: "shield", desc: "Responds when someone is hurt on common property, and under a standard form the carrier defends the association as well." },
  { title: "Umbrella / Excess Liability", icon: "umbrella", desc: "Sits above the primary liability limits, for the claim that exceeds them. An umbrella generally follows the underlying forms, so what the primary excludes it usually excludes too." },
  { title: "Directors & Officers Liability", icon: "briefcase", desc: "Responds when a board member is personally named over a governance decision — defence costs are usually the largest part of it." },
  { title: "Crime and Fidelity", icon: "lock", desc: "Covers theft of association funds by an employee or volunteer, and — where the form is extended for it — by a third party. Lender guidelines commonly set a minimum limit against the funds you hold." },
  { title: "Ordinance or Law", icon: "scale", desc: "Meets the extra cost of rebuilding to today's code after a covered loss, when the original construction no longer complies. It is bought in parts, each with its own limit, and matters most in older buildings." },
];

/* 03 — The agitate step. Stated plainly, no alarm: each line is a condition a
   board can check, not a warning. */
const COMMON_ISSUES = [
  { title: "Underinsured buildings", desc: "The building limit was set years ago and construction costs have risen since. A total loss would not rebuild the property." },
  { title: "Stale replacement-cost figures", desc: "The valuation on file predates the last renewal, so every limit derived from it is out of date as well." },
  { title: "Per-unit deductibles nobody has read", desc: "The master policy applies a deductible to each unit. Owners discover the amount when they file a claim, not before." },
  { title: "Missing fidelity bond limits", desc: "The bond is in force, but the limit does not reflect the funds the association actually holds." },
  { title: "Lender warrantability failures", desc: "Something in the coverage places the project outside lender guidelines, and an owner discovers it at closing." },
  { title: "Gaps between master and HO-6", desc: "Both policies are in force, and neither responds to the loss the association is looking at." },
];

/* Common master-policy structures; the issued policy and documents control. */
const POLICY_TYPES = [
  { name: "Bare walls", covers: "Structure and common elements", stops: "Typically excludes unit interiors; the policy and governing documents control", owner: "Most" },
  { name: "Single entity", covers: "Structure, common elements, and usually original fixtures and finishes", stops: "Typically excludes improvements added by an owner", owner: "Some" },
  { name: "All-in", covers: "Structure, common elements, original finishes and usually owner improvements", stops: "Typically excludes belongings and personal liability", owner: "Least" },
];

/** Common HO-6 coverages; actual scope depends on the issued form. */
const HO6_COVERAGES = [
  { title: "Loss assessment", desc: "May respond when an association validly assesses a covered deductible or shortfall to owners, subject to the HO-6 terms and limit." },
  { title: "Coverage A for improvements", desc: "The finishes and fixtures inside your unit, at a limit that reflects what is actually there." },
  { title: "Water backup and seepage", desc: "Coverage for these causes of loss is not automatically included and depends on the form and endorsements." },
  { title: "Personal property", desc: "Belongings — written at replacement cost rather than depreciated value where the form is endorsed for it." },
  { title: "Personal liability and umbrella", desc: "Reviewed alongside the association's liability limits and the owner's broader exposures." },
];

/* 06 — Who we work with. Same four audiences and the same marks as the homepage
   section, so the two pages say this once and say it identically. */
const AUDIENCES = [
  { icon: "board",     title: "Boards & trustees",     cta: "Request a board review",       href: QUOTE_URL },
  { icon: "manager",   title: "Property managers",     cta: "Talk to us about a portfolio", href: "/contact/" },
  { icon: "developer", title: "Developers & sponsors", cta: "Discuss a new project",        href: "/contact/" },
  { icon: "owner",     title: "Unit owners",           cta: "Get HO-6 coverage",            href: QUOTE_URL },
];

/** Shared by the visible FAQ and structured data. */
const FAQS = [
  { q: "What is the difference between an HOA master policy and an HO-6?", a: "The master policy is the association's insurance and generally addresses shared buildings, common elements, association liability and other association exposures. An HO-6 can cover belongings, personal liability, loss assessment and portions of a unit outside the master policy. The boundary depends on the master-policy form, governing documents, applicable law and endorsements." },
  { q: "Who pays for the HOA master policy?", a: "The association purchases the master policy and generally funds its premium through member assessments. The association is the named insured; claim procedures depend on the policy and the loss. An owner's HO-6 is a separate policy paid for by that owner." },
  { q: "What should a board review at renewal?", a: "Building valuation and limit adequacy, the deductible structure including any per-unit deductible, ordinance or law limits, general liability, umbrella, D&O, and the fidelity bond limit against the funds held. We review each of these and set out the findings in writing." },
];

const faqJsonLd = faqPageSchema(PAGE_URL, FAQS);
---

<Layout
  title="HOA Insurance & HO-6 Coverage — ProtectMyHOA"
  description="Specialists in HOA master insurance policies and HO-6 condo unit owner coverage. Property, liability, D&O, crime, umbrella — built to work together."
  canonicalPath="/what-we-do/"
  jsonLd={[faqJsonLd]}
>
  {/* ═══ Hero — same treatment as the homepage ══════════════════════ */}
  <Hero
    eyebrow="ProtectMyHOA™"
    title="HOA Insurance"
    subtitle="Master insurance for the association, HO-6 for the unit owner, and a written record of why each was placed the way it was."
    backgroundImage="/images/modern-building.jpg"
    backgroundVideo="/images/hero-video.mp4"
  >
    <HeroLookup slot="action" />
  </Hero>

  <div class="wwd">
  {/* ═══ 01 · What is an HOA master policy ═════════════════════════ */}
  <section class="section" aria-labelledby="define-h">
    <div class="container">
      <div class="wwd-split">
        <div class="wwd-split__lead">
          <p class="eyebrow">The master policy</p>
          <h2 class="section-title" id="define-h">What is an HOA master policy?</h2>
          <p class="wwd-lead">
            It is the association's own insurance, funded through member assessments rather
            than by any individual owner. It responds to the shared buildings and common
            elements, the association's liability, the funds it holds, and the decisions its
            board makes.
          </p>
          {/* The four objects it responds to, folded in here rather than given
               their own section: they are part of the definition, and a separate
               band added a full screen of scrolling to say so. */}
          <ol class="responds-inline">
            {RESPONDS_TO.map((r) => (
              <li>
                <h3>{r.title}</h3>
                <p>{r.desc}</p>
              </li>
            ))}
          </ol>
          <p class="wwd-closer">
            What it does not do is cover the inside of an individual unit. That is what an
            HO-6 is for, and where the two policies meet is set by your governing documents.
          </p>
          <div class="wwd-cta">
            <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
            <span class="wwd-cta__note">Free review. No broker fee, now or at renewal.</span>
          </div>
        </div>
        <div class="wwd-split__media">
          <img
            src="/images/master-policy-community.jpg"
            alt="Residents walking through a managed condominium community past shared buildings, landscaped common areas and a gazebo"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ═══ 02 · Key master policy coverages ══════════════════════════ */}
  <section class="section" aria-labelledby="cov-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Coverage</p>
        <h2 class="section-title" id="cov-h">Key master policy coverages</h2>
        <p class="section-subtitle">
          Six coverages placed as one program, so the limits and deductibles agree with each
          other rather than being bought in isolation.
        </p>
      </div>
      {/* One hairline panel, three across. The icon sits inline with the policy
           name rather than stacked above it, which removes roughly 64px per cell
           — six stacked cards ran to about twice this height. */}
      <div class="cov-grid">
        {MASTER_COVERAGES.map((c) => (
          <article class="cov-card">
            <span class="cov-card__mark" aria-hidden="true">
              {c.icon === "building" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01"/><path d="M10 21v-3h4v3"/></svg>}
              {c.icon === "shield" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 9.5-8 10-4.5-.5-8-5-8-10V6l8-4z"/></svg>}
              {c.icon === "umbrella" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="M2 12a10 10 0 0120 0H2z"/><path d="M12 12v7a3 3 0 01-6 0"/></svg>}
              {c.icon === "briefcase" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/><path d="M3 13h18"/></svg>}
              {c.icon === "lock" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>}
              {c.icon === "scale" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M5 7h14"/><path d="M5 7l-2 6a4 4 0 008 0L9 7"/><path d="M19 7l-2 6a4 4 0 008 0l-2-6"/></svg>}
            </span>
            <div class="cov-card__body">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          </article>
        ))}
      </div>
      {/* One qualifier for the whole grid rather than a hedge bolted onto each of
          the six descriptions. The cards say what these coverages are FOR; this
          line says that what any given association can actually buy depends on
          the market and the risk. */}
      <p class="cov-note">
        Workers compensation and earthquake are available separately, and are quoted alongside
        the program where an association needs them. Carrier availability varies by state,
        association type and risk profile, and coverage is subject to underwriting, policy
        terms, and eligibility.
      </p>
      {/* Section-specific label rather than the page's generic primary: this
           section is about the six coverages, so the button names that job. */}
      <div class="wwd-cta wwd-cta--center">
        <a href={QUOTE_URL} class="btn btn-primary">Review My Six Coverages</a>
        <span class="wwd-cta__note">See which of the six your association is missing.</span>
      </div>
    </div>
  </section>

  {/* ═══ 03 · Common HOA insurance issues ══════════════════════════ */}
  <section class="section section--navy" aria-labelledby="issues-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow eyebrow--gold">What we find</p>
        <h2 class="section-title wwd-invert" id="issues-h">Common HOA insurance issues</h2>
        <p class="section-subtitle wwd-invert-sub">
          Six conditions we identify most often on a first review of an association's master
          policy. None of them are unusual, and each can be verified before a claim rather
          than after one.
        </p>
      </div>
      {/* Accordion rather than six open rows. The titles alone carry the agitate
           step — "underinsured buildings" needs no explanation to land — and
           collapsing the detail halves the height of the section. Native
           <details>, so it works with no JavaScript. */}
      <div class="issues-acc">
        {COMMON_ISSUES.map((iss, i) => (
          <details class="issue-acc">
            <summary>
              <span class="issue-acc__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="issue-acc__title">{iss.title}</span>
              <span class="issue-acc__chev" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </span>
            </summary>
            <p>{iss.desc}</p>
          </details>
        ))}
      </div>
      <div class="issues-foot">
        <p class="issues-foot__text">
          We identify which of the six apply to your association, and put the findings in
          writing.
        </p>
        <a href={QUOTE_URL} class="btn btn-gold issues-foot__cta">Request Insurance Review</a>
      </div>
    </div>
  </section>

  {/* ═══ 04 · Where the master policy and HO-6 meet ════════════════ */}
  <section class="section" aria-labelledby="stops-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Who pays</p>
        <h2 class="section-title" id="stops-h">Where the master policy and HO-6 meet</h2>
        <p class="section-subtitle">
          Bare-walls, single-entity and all-in forms allocate unit property differently. The
          issued policy, endorsements and governing documents determine which arrangement applies.
        </p>
      </div>

      <div class="types-table-wrap">
        <table class="types-table">
          <thead>
            <tr>
              <th scope="col">Master policy type</th>
              <th scope="col">The association covers</th>
              <th scope="col">Common unit-owner gap</th>
              <th scope="col" class="types-table__owner-col">Owner carries</th>
            </tr>
          </thead>
          <tbody>
            {POLICY_TYPES.map((t) => (
              <tr>
                <th scope="row">{t.name}</th>
                <td>{t.covers}</td>
                <td>{t.stops}</td>
                <td class="types-table__owner-col"><span class="owner-pill">{t.owner}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="stops-pair">
        <div class="stops-item">
          <h3>The deductible</h3>
          <p>
            A deductible may apply per occurrence or per unit. Whether any amount can be
            allocated to an owner depends on the policy, governing documents, applicable law,
            allocation provisions and the facts of the loss.
          </p>
        </div>
        <div class="stops-item">
          <h3>Loss assessment</h3>
          <p>
            An association may be able to assess certain deductibles or shortfalls to owners.
            HO-6 loss-assessment coverage may respond when the cause and assessment are covered,
            subject to its own terms and limit.
          </p>
        </div>
      </div>

      <div class="stops-foot">
        <p class="stops-foot__text">
          Plenty of boards could not say which of the three their association carries. It is
          stated in the governing documents, and we identify it on every review.
        </p>
        <a href={QUOTE_URL} class="btn btn-primary stops-foot__cta">Request Insurance Review</a>
      </div>
    </div>
  </section>

  {/* ═══ 05 · HO-6 for unit owners ═════════════════════════════════ */}
  <section class="section section--alt" aria-labelledby="ho6-h">
    <div class="container">
      <div class="wwd-split wwd-split--reverse">
        <div class="wwd-split__media">
          <img
            src="/images/ho6-unit-owner.jpg"
            alt="A condominium unit owner reviewing an HO-6 quote at her dining table inside her own unit"
            width="1200"
            height="960"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="wwd-split__lead">
          <p class="eyebrow">Unit owners</p>
          <h2 class="section-title" id="ho6-h">HO-6 add-on coverage</h2>
          <p class="wwd-lead">
            HO-6 is the owner's side of the arrangement. It can cover belongings, personal
            liability, loss assessment and portions of the unit outside the master policy.
            The issued master policy and governing documents determine how the two fit together.
          </p>
          <blockquote class="ho6-pull">
            A lender may require HO-6 coverage based on the loan type and project requirements.
          </blockquote>
          <ul class="ho6-list">
            {HO6_COVERAGES.map((h) => (
              <li>
                <h3>{h.title}</h3>
                <p>{h.desc}</p>
              </li>
            ))}
          </ul>
          <p class="ho6-closer">
            We place both policies and set out in writing how the available documents and forms
            allocate responsibility before a loss occurs.
          </p>
          <div class="wwd-cta">
            <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
            <span class="wwd-cta__note">Written against your association's actual master policy.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══ 06 · Who we work with ══════════════════════════════════════ */}
  <section class="section" aria-labelledby="types-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Who we serve</p>
        <h2 class="section-title" id="types-h">Who we work with</h2>
        {/* The footprint is read from shared/agency.ts rather than typed here.
            It was correct as hand-written text, but this page was the last one
            still asserting it in prose: every other surface — the footer, the
            coverage map, /contact, the get-started template — interpolates
            AGENCY.areaServed, which is how the obsolete six-state list survived
            in so many places for so long. One source, no drift. */}
        <p class="section-subtitle">
          Four groups, each needing something different from the same placement. Licensed in
          {" "}{AGENCY.areaServed}.
        </p>
      </div>
      <div class="aud-grid">
        {AUDIENCES.map((a) => (
          <div class="aud-card">
            <span class="aud-card__mark" aria-hidden="true">
              {a.icon === "board" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 19v-1.4a3.4 3.4 0 00-3.4-3.4H7.4A3.4 3.4 0 004 17.6V19"/><circle cx="9.75" cy="7.6" r="3.4"/><path d="M16.6 11.1a3.2 3.2 0 000-6.3"/><path d="M20 19v-1.4a3.3 3.3 0 00-2.3-3.1"/></svg>}
              {a.icon === "manager" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01"/><path d="M10 21v-3h4v3"/></svg>}
              {a.icon === "developer" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M3 10h6M15 9h6M15 14h6"/></svg>}
              {a.icon === "owner" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.6L12 3l9 7.6"/><path d="M5.4 9.6V20h13.2V9.6"/><path d="M10 20v-5.2h4V20"/></svg>}
            </span>
            <h3>{a.title}</h3>
            <a href={a.href} class="text-link aud-card__cta">{a.cta} &gt;</a>
          </div>
        ))}
      </div>
      <div class="wwd-cta wwd-cta--center">
        <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
        <span class="wwd-cta__note">Free, no obligation, and no broker fee.</span>
      </div>
    </div>
  </section>

  {/* ═══ 07 · FAQ ══════════════════════════════════════════════════ */}
  {/* FAQS supplies both the visible accordion and the FAQPage node. */}
  <section class="section section--alt" id="faq" aria-labelledby="faq-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Questions</p>
        <h2 class="section-title" id="faq-h">Frequently Asked Questions</h2>
      </div>
      <div class="faq-list">
        {FAQS.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="wwd-cta wwd-cta--center">
        <a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a>
        <a href="/contact/" class="text-link">Or ask us a question &gt;</a>
      </div>
    </div>
  </section>

  {/* Same treatment as /contact section 02: showClaims adds the claims and urgent
      block beneath the address, so the contact block is identical on both pages. */}
  <ContactForm showClaims client:visible />
  </div>
</Layout>
