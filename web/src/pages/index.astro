---
import Layout from "../layouts/Layout.astro";
import CondoIndicationCta from "../components/CondoIndicationCta.astro";
import Hero from "../components/Hero.astro";
import HeroLookup from "../components/HeroLookup.astro";
import CoverageMap from "../components/CoverageMap.astro";
import { CoverageCalculator } from "../components/CoverageCalculator";
import { STAGES } from "../data/process";
import { MARKETS } from "../data/markets";
import { PHONE, QUOTE_URL } from "../constants";
import { canonicalUrl, faqPageSchema } from "../lib/seo";
import "../pages/Home.css";

/** Decorative section marks; the adjacent text supplies their labels. */
const ASSOC_FIGURES: { img: string; value: string; label?: string }[] = [
  { img: "states", value: "Licensed in all 50 states", label: "and the District of Columbia" },
  { img: "coverage", value: "12 markets", label: "one program" },
  { img: "written", value: "Written rationale", label: "on every placement" },
];

const PRACTICE_CARDS = [
  {
    icon: "compass",
    title: "Independent, so you’re never tied to one insurer",
    desc: "A captive agent can offer only one company’s policy. As an independent HOA Insurance agency, we’re appointed with multiple providers, so if your current carrier raises rates or non-renews, your board has other markets to approach.",
  },
  {
    icon: "layers",
    title: "Up to 12 markets, one submission",
    desc: "You complete one submission instead of chasing carriers one by one. We present it to the appointed markets that write condo and HOA risks like yours and bring every quote we receive back to you.",
  },
  {
    icon: "clipboard",
    title: "Specialists, not generalists",
    desc: "Condo and HOA association Insurance is all we do, so we already know the questions that come up at renewal: master policy forms, deductibles, valuations and lender requirements.",
  },
  {
    icon: "nofee",
    title: "No broker fee",
    desc: "Your preliminary premium indication, coverage review and market comparison cost your association nothing. Our compensation is disclosed on every option, and nothing is bound until your board chooses.",
  },
];

/* 04 — The Board Record.
   Numbered because these are the document's own contents in order, not a
   decorative sequence. */
const BOARD_RECORD = [
  { num: "01", title: "What we reviewed", desc: "Your current master policy, loss runs and governing documents, read together so the coverage matches what your documents require." },
  { num: "02", title: "Which Insurance companies we approached", desc: "Each one named, with the response it gave, so owners can see the market was genuinely tested." },
  { num: "03", title: "What each option costs", desc: "Premium, deductible and limits for every option in one table, so you see the full HOA Insurance cost, not just the lowest premium." },
  { num: "04", title: "Why we recommended it", desc: "Our reasoning in plain language, free of jargon, so any board member can present it to owners." },
  { num: "05", title: "What is still not covered", desc: "Every gap named in writing, including deductible and special assessment exposure owners may face, not left out of the proposal." },
  { num: "06", title: "What to revisit next year", desc: "Items like building valuations and deductibles that need attention before your next renewal." },
];

/* 09 — Who we work with.
   Descriptions removed by request: each card is now a mark, a title and its CTA.
   No audience artwork was supplied, so the marks are the same stroked SVG set
   used by the section 03 cards — consistent with the rest of the page and
   identical on every platform, which emoji would not be. */
const AUDIENCES = [
  { icon: "board",     title: "Boards & trustees",     cta: "Request a board review",      href: QUOTE_URL },
  { icon: "manager",   title: "Property managers",     cta: "Talk to us about a portfolio", href: "/contact/" },
  { icon: "developer", title: "Developers & sponsors", cta: "Discuss a new project",        href: "/contact/" },
  { icon: "owner",     title: "Unit owners",           cta: "Get HO-6 coverage",            href: "/what-we-do/" },
];

/* Shared by the visible accordion and FAQ structured data. */
const FAQS = [
  { q: "What is master Insurance on a condo?", a: "Master Insurance is the condo association’s own policy, paid for through member assessments. It typically covers the building structure and common elements, such as roofs, hallways, elevators and grounds, along with the association’s general liability. Many associations carry D&O, crime and umbrella coverage alongside it. How far the master policy reaches inside each unit depends on whether it is written as bare walls, single entity or all-in." },
  { q: "Does condo Insurance cover water damage?", a: "Often, but which policy responds depends on where the water came from and what it damaged. Sudden, accidental leaks, such as a burst pipe, are commonly covered. Gradual leaks, flooding and sewer backup usually are not unless specifically added. Damage to common elements generally falls to the master policy, while your belongings and interior finishes generally fall to your HO-6. The master policy form, deductible and governing documents decide the rest." },
  { q: "How much does condo Insurance cost?", a: "It depends on the policy. A condo association’s master policy premium is driven by the building’s replacement cost, location, construction, age, loss history, deductible and the limits your governing documents require. A unit owner’s HO-6 premium is usually much lower because it covers only the owner’s share. Because these factors vary so widely, the most reliable starting point is a preliminary premium indication for your property, followed by bindable quotes from the Insurance companies that write it." },
  { q: "How much condo Insurance do I need?", a: "Start with your association’s master policy. Under a bare walls form, you may need dwelling coverage for interior walls, fixtures, cabinets and flooring. Under an all-in form, you may need it only for upgrades you’ve made. Add personal property coverage for your belongings, personal liability, and loss assessment coverage at least equal to your share of the association’s deductible. Your lender may also set minimum requirements." },
];

const HOME_CANONICAL = canonicalUrl("/");
const faqJsonLd = faqPageSchema(HOME_CANONICAL, FAQS);
---

<Layout
  title="HOA Insurance for Condominium Associations & Unit Owners — ProtectMyHOA"
  description={"Independent HOA insurance agency: master policies, D&O and HO-6 condo coverage. Free reviews for boards, licensed in all 50 states and DC. Call " + PHONE + "."}
  canonicalPath="/"
  jsonLd={[faqJsonLd]}
>
  {/* ═══ 01 · Hero ═══════════════════════════════════════════════════ */}
  <Hero
    eyebrow="Licensed Nationwide · Independent HOA & Condo Insurance Agency"
    title="Insurance Built for Associations"
    subtitle="Enter your association’s address for a preliminary premium indication on your master policy. Then receive bindable quotes from up to 12 appointed Insurance companies, compared side by side on coverage, deductibles and limits."
    backgroundImage="/images/hero-people.jpg"
    backgroundVideo="/images/hero-video.mp4"
    autoplayVideo
    short
  >
    <HeroLookup
      slot="action"
      placeholder="Association address"
      buttonText="Get My Premium Indication"
      microcopy="Free and available today. No broker fee."
    />
  </Hero>

  {/* ═══ 02 · Association insurance ══════════════════════════════════ */}
  <section class="section band-assoc" aria-labelledby="assoc-h">
    <div class="container band-assoc__grid">
      <div class="band-assoc__lead">
        <p class="eyebrow eyebrow--gold">Condo association Insurance</p>
        <h2 class="section-title band-assoc__title" id="assoc-h">
          What does a condo association Insurance policy cover?
        </h2>
        <div class="band-assoc__body">
          <p>
            The master policy is the association’s own Insurance, funded through member
            assessments. It typically includes condo building Insurance for the shared
            structures and common elements, general liability, directors and officers (D&amp;O)
            liability for board decisions, and crime coverage for the funds the association
            holds.
          </p>
          <p>
            Whether your policy is bare walls, single entity or all-in (also called walls-in)
            helps decide where the master policy ends and a unit owner’s HO-6 begins. The
            governing documents, applicable law and endorsements decide the rest.
          </p>
        </div>
        <a href="/condo-insurance/" class="btn btn-gold">See what a master policy covers</a>
        <CondoIndicationCta tone="dark" />
      </div>
      <ul class="assoc-figs">
        {ASSOC_FIGURES.map((f) => (
          <li class="assoc-fig">
            <img
              class="assoc-fig__img"
              src={`/images/figures/${f.img}.png`}
              alt=""
              width="288"
              height="192"
              loading="lazy"
              decoding="async"
            />
            <span class="assoc-fig__text">
              <span class="assoc-fig__v">{f.value}</span>
              {f.label && <span class="assoc-fig__l">{f.label}</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ═══ 03 · What we are ════════════════════════════════════════════ */}
  <section class="section" aria-labelledby="what-h">
    <div class="container">
      <div class="what-grid">
        <div class="what-lead">
          <p class="eyebrow">Your HOA Insurance agency</p>
          <h2 class="section-title" id="what-h">The right HOA Insurance company for your association, not just the one available.</h2>
          <p class="section-subtitle">
            Non-renewals, rising premiums and carriers that are hard to reach can leave a board
            feeling stuck. ProtectMyHOA is the brand of HOA Insurance Agency, a professional
            condo and HOA Insurance agency, licensed nationwide, that does the shopping for you.
            Our agents take your association to the HOA Insurance providers that write your
            risk and bring the options back to your board.
          </p>
          {/* CTA sits with the lead copy, not only after the four cards. A visitor
               reaching this section can act on it without scrolling past the grid. */}
          <div class="what-actions">
            <a href={QUOTE_URL} class="btn btn-gold">Compare HOA Insurance companies</a>
            <a href="/about-us/" class="text-link">Meet the agency behind ProtectMyHOA &gt;</a>
          </div>
        </div>
        <div class="what-media">
          {/* Decorative and muted, so it autoplays; the poster shows until it starts. */}
          <video
            src="/images/hoa-intro.mp4"
            poster="/images/practice-team.jpg"
            width="1920"
            height="1080"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          />
        </div>
      </div>

      <div class="practice-grid">
        {PRACTICE_CARDS.map((c) => (
          <div class="practice-card">
            <span class="practice-card__mark" aria-hidden="true">
              {c.icon === "compass" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.6 8.4l-2.2 5-5 2.2 2.2-5z"/></svg>}
              {c.icon === "layers" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>}
              {c.icon === "clipboard" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>}
              {c.icon === "nofee" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M6.2 17.8L17.8 6.2"/></svg>}
            </span>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>

      <div class="section-cta-wrap">
        <a href={QUOTE_URL} class="btn btn-primary">Start my premium indication</a>
      </div>
    </div>
  </section>

  {/* ═══ 04 · The Board Record ═══════════════════════════════════════ */}
  <section class="section section--navy" aria-labelledby="record-h">
    <div class="container">
      <div class="record-grid">
        <div class="record-lead">
          <p class="eyebrow eyebrow--gold">The ProtectMyHOA Board Record</p>
          <h2 class="section-title record-h2" id="record-h">
            You serve your association. We put every HOA Insurance decision in writing.
          </h2>
          <div class="record-body">
            <p>
              We know how renewal season feels: premiums rising, owners asking questions, and a
              board expected to make a decision it will have to explain. A quote alone doesn’t
              make that case. That’s why every condo association policy we place comes with the
              ProtectMyHOA Board Record, a short written summary built to be filed with your
              meeting minutes.
            </p>
            <p>
              Board members can face personal questions, and sometimes claims, over the
              decisions they make. Alongside your HOA liability Insurance and D&amp;O coverage,
              the Board Record documents the information you had and the reasoning behind your
              choice.
            </p>
          </div>
          {/* Lead-capture CTA sits with the copy as well as at the close, so a
               visitor can act before scrolling the six items. */}
          <a href={QUOTE_URL} class="btn btn-gold record-lead__cta">Get a board-ready recommendation</a>
        </div>
        <div class="record-media">
          <img
            src="/images/board-record-desk.jpg"
            alt="Insurance professional annotating an association's policy documents while preparing the written record"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <ol class="record-items">
        {BOARD_RECORD.map((r) => (
          <li class="record-item">
            <span class="record-item__num" aria-hidden="true">{r.num}</span>
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </li>
        ))}
      </ol>

      <div class="record-close">
        <p class="record-close__line">Coverage your board can defend, and owners can understand.</p>
        <div class="record-close__actions">
          <a href={QUOTE_URL} class="btn btn-gold">Protect my HOA at renewal</a>
          <a href="/contact/" class="btn btn-outline">Talk to a licensed HOA agent</a>
        </div>
      </div>
    </div>
  </section>

  {/* ═══ 05 · Review. Compare. Place. Record. ════════════════════════ */}
  <section class="section" aria-labelledby="stages-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">The process</p>
        <h2 class="section-title" id="stages-h">Review. Compare. Place. Record.</h2>
        <p class="section-subtitle">
          Four stages, in order, on a schedule the board can hold us to.
        </p>
      </div>
      <ol class="stage-grid">
        {STAGES.map((s) => (
          <li class="stage-card reveal">
            <span class="stage-num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))}
      </ol>
      <div class="section-cta-wrap">
        <a href={QUOTE_URL} class="btn btn-primary">Start stage one</a>
      </div>
    </div>
  </section>

  {/* ═══ 06 · Our markets ════════════════════════════════════════════ */}
  <section class="section section--alt" aria-labelledby="markets-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Our markets</p>
        <h2 class="section-title" id="markets-h">Markets a board will recognize</h2>
        <p class="section-subtitle">Direct appointments with twelve markets, national insurers alongside the specialists.</p>
      </div>

      {/* Single-line logo marquee, scrolling right to left.
           The set is rendered TWICE and the track animates to -50%, so the
           second copy is exactly where the first started when the loop resets —
           that is what makes it seamless rather than snapping back. The duplicate
           is aria-hidden so assistive tech reads twelve carriers, not
           twenty-four. Pauses on hover and on focus-within, and collapses to a
           static wrapped grid under prefers-reduced-motion. */}
      <div class="carrier-marquee">
        <ul class="carrier-track">
          {MARKETS.map((m) => (
            <li class="carrier">
              <img
                class="carrier__logo"
                src={`/images/carriers/${m.slug}.png`}
                alt={m.name}
                width="240"
                height="120"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
          {MARKETS.map((m) => (
            <li class="carrier" aria-hidden="true">
              <img
                class="carrier__logo"
                src={`/images/carriers/${m.slug}.png`}
                alt=""
                width="240"
                height="120"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>

      <p class="carrier-note">
        Carrier availability varies by state, association type and risk profile. Not every
        market is approached on every placement.
      </p>

      <div class="section-cta-wrap">
        <a href={QUOTE_URL} class="btn btn-primary">Request your market comparison</a>
      </div>
    </div>
  </section>

  {/* ═══ 07 · Compensation ═══════════════════════════════════════════ */}
  {/* Laid out as a paid-style panel: the yard-sign artwork carries the claim
       and the copy substantiates it. Navy ground and gold accent are the site's
       own, so it reads as a house ad rather than bolted-on advertising. */}
  <section class="section band-fee" aria-labelledby="fee-h">
    <div class="container band-fee__panel">
      <div class="band-fee__media">
        <img
          src="/images/no-broker-fee.jpg"
          alt="Yard sign outside a condominium community reading zero dollar broker fee, HOA Insurance with transparency you can trust"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="band-fee__lead">
        <p class="eyebrow eyebrow--gold">Compensation</p>
        <h2 class="section-title band-fee__title" id="fee-h">
          No broker fee. Not now, not at renewal.
        </h2>
        <ul class="fee-points">
          <li>No broker fee, no consulting fee, no fee to review what you already have</li>
          <li>Compensation disclosed in The Board Record on every placement</li>
          <li>What we are paid is disclosed for every option, so you can weigh the recommendation against it</li>
        </ul>
        <div class="band-fee__actions">
          <a href={QUOTE_URL} class="btn btn-gold">Request your Insurance review</a>
          <a href="#states" class="btn btn-outline">See the states we cover</a>
        </div>
      </div>
    </div>
  </section>

  {/* ═══ 08 · Coverage tool ══════════════════════════════════════════ */}
  {/* CoverageCalculator supplies its own badge, H2 and standfirst, so this
       section adds no heading of its own — a second one would just compete.
       NOTE: its own CTAs only render once the tool is completed, so this is the
       one section with no CTA visible on arrival. The trailing strip that used to
       cover that was removed by request. */}
  <CoverageCalculator client:visible />

  {/* ═══ 09 · Who we work with ═══════════════════════════════════════ */}
  {/* NOT section--alt: that is the same gray as .calc-section above it, so the
       two ran together as one continuous band with no visible boundary. White
       plus a hairline rule makes the change of section read while the tool is
       still on screen. */}
  <section class="section aud-band" aria-labelledby="aud-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Who we serve</p>
        <h2 class="section-title" id="aud-h">Who we work with</h2>
        <p class="section-subtitle">
          Four groups, each needing something different from the same placement.
        </p>
      </div>
      <div class="aud-grid">
        {AUDIENCES.map((a) => (
          <div class="aud-card">
            <span class="aud-card__mark" aria-hidden="true">
              {a.icon === "board" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 19v-1.4a3.4 3.4 0 00-3.4-3.4H7.4A3.4 3.4 0 004 17.6V19"/><circle cx="9.75" cy="7.6" r="3.4"/><path d="M16.6 11.1a3.2 3.2 0 000-6.3"/><path d="M20 19v-1.4a3.3 3.3 0 00-2.3-3.1"/></svg>}
              {a.icon === "manager" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01"/><path d="M10 21v-3h4v3"/></svg>}
              {a.icon === "developer" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M3 10h6M15 9h6M15 14h6"/></svg>}
              {a.icon === "owner" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.6L12 3l9 7.6"/><path d="M5.4 9.6V20h13.2V9.6"/><path d="M10 20v-5.2h4V20"/></svg>}
            </span>
            <h3>{a.title}</h3>
            <a href={a.href} class="text-link aud-card__cta">{a.cta} &gt;</a>
          </div>
        ))}
      </div>
      <div class="section-cta-wrap">
        <a href="/contact/" class="btn btn-primary">Contact HOA Insurance Agency</a>
      </div>
    </div>
  </section>

  {/* ═══ 10 · HO-6 — deliberately demoted ═══════════════════════════ */}
  {/* Per brand direction HO-6 does not lead. It keeps a single compact card
       here rather than the half-page treatment it had, and the /what-we-do link
       is retained so the internal path to that page survives. */}
  <section class="section" aria-labelledby="ho6-h">
    <div class="container">
      <aside class="ho6-card">
        <div class="ho6-card__body">
          <p class="eyebrow">Condo Insurance for unit owners</p>
          <h2 class="ho6-card__title" id="ho6-h">Your condo Insurance policy should start where the master policy ends.</h2>
          <p class="ho6-card__sub">HO-6 condo Insurance, matched to your association’s master policy</p>
          <p class="ho6-card__lead">
            Your lender may require HO-6 coverage, and a leak from the unit above or a special
            assessment after a building claim can arrive without warning.
          </p>
          <p>
            An HO-6 condo Insurance policy can cover your belongings, personal liability, loss
            assessment and the parts of your unit the master policy doesn’t, such as interior
            walls, fixtures and improvements under a bare walls form. Licensed nationwide, our
            agents review it against your association’s actual master policy and governing
            documents, not a generic template, so the two policies are coordinated.
          </p>
        </div>
        <a href="/what-we-do/" class="btn btn-primary ho6-card__cta">Review my condo Insurance policy</a>
      </aside>
    </div>
  </section>

  {/* ═══ 11 · HOA insurance by state ════════════════════════════════ */}
  {/* The map's guide tiles are the ONLY crawl path from this page to the state
       landing pages. They are real <a href> elements inside CoverageMap — keep
       them. The former split layout (a pin row plus a separate "also licensed in"
       chip list) is merged into the one map, which carries every jurisdiction and
       the CTA. */}
  <section class="section section--alt" id="states" aria-labelledby="states-h">
    <div class="container" style="text-align: center">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Coverage area</p>
        <h2 class="section-title" id="states-h">HOA Insurance by State</h2>
        <p class="section-subtitle">
          Licensed in all 50 states and the District of Columbia. Carrier availability varies
          by state, association type and risk profile.
        </p>
      </div>

      <CoverageMap ctaHref={QUOTE_URL} ctaLabel="Request a review in your state" />
    </div>
  </section>

  {/* ═══ 12 · FAQ — feeds the FAQPage schema above ══════════════════ */}
  {/* The FAQS array is the source for both this markup and faqJsonLd. Editing
       an answer here edits the rich-result payload. See docs/WEBSITE-STRUCTURE.md §6. */}
  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="container">
      <div class="sec-head sec-head--center">
        <p class="eyebrow">Questions</p>
        <h2 class="section-title" id="faq-h">Frequently Asked Questions About Condo &amp; HOA Insurance</h2>
      </div>
      <div class="faq-list">
        {FAQS.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="section-cta-wrap">
        <a href={QUOTE_URL} class="btn btn-primary">Ask a licensed agent</a>
      </div>
    </div>
  </section>
</Layout>
