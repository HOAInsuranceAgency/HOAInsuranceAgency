---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { BlogLeadForm } from "../../components/BlogLeadForm";
import { publishedArticles, articlePath, articleDate, articleWordCount } from "../../lib/articles";
import { articleSchemaNode } from "../../lib/article-seo";
import { breadcrumbSchema } from "../../lib/seo";
import { categoryCta } from "../../data/blog";
import { QUOTE_URL } from "../../constants";
import { AGENCY } from "../../../../shared/agency";
import "./articles.css";

export async function getStaticPaths() {
  const articles = publishedArticles(await getCollection("articles"));
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article, articles } }));
}
interface Props { article: CollectionEntry<"articles">; articles: CollectionEntry<"articles">[] }
const { article, articles } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
const contents = headings.filter((heading) => heading.depth === 2);
const minutes = Math.max(1, Math.ceil(articleWordCount(article.body ?? "") / 220));
const cta = categoryCta(data.topic);

// The mid-article prompt sits before the middle section heading. The HTML is
// the loader's own rendering, already checked by assertArticleHtml, so it is
// split, not re-rendered. Short articles keep <Content /> and no mid prompt.
const html = article.rendered?.html ?? "";
const sectionStarts = [...html.matchAll(/<h2[\s>]/g)].map((match) => match.index ?? 0);
const splitAt = sectionStarts.length >= 3 ? sectionStarts[Math.floor(sectionStarts.length / 2)] : -1;

// Same category first, then the most recent of the rest.
const related = articles.filter((other) => other.id !== article.id)
  .sort((a, b) => Number(b.data.topic === data.topic) - Number(a.data.topic === data.topic))
  .slice(0, 3);
---

<Layout title={`${data.title} | ProtectMyHOA`} description={data.description} canonicalPath={articlePath(data.slug)} ogImage={data.image.src} ogImageAlt={data.image.alt} ogImageWidth={data.image.width} ogImageHeight={data.image.height} ogType="article" publishedAt={data.publishedAt} modifiedAt={data.updatedAt} solidNav jsonLd={[
  articleSchemaNode(article),
  breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Articles", path: "/blog/" }, { name: data.title, path: articlePath(data.slug) }]),
]}>
  <article class="article-page">
    <header class="article-header container">
      <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Articles</a><span aria-hidden="true">/</span><span>{data.topic}</span></nav>
      <p class="articles-eyebrow">{data.topic}</p>
      <h1>{data.title}</h1>
      <p class="article-description">{data.description}</p>
      <div class="article-meta"><span>By {AGENCY.name}</span><span aria-hidden="true">·</span><time datetime={data.publishedAt}>{articleDate(data.publishedAt)}</time><span aria-hidden="true">·</span><span>{minutes} min read</span></div>
      {data.updatedAt && <p class="article-updated">Updated <time datetime={data.updatedAt}>{articleDate(data.updatedAt)}</time></p>}
    </header>
    <figure class="article-cover container"><img src={data.image.src} alt={data.image.alt} width={data.image.width} height={data.image.height} loading="eager" fetchpriority="high" /><figcaption>{data.image.sourceUrl ? <a href={data.image.sourceUrl} rel="noopener noreferrer">{data.image.credit}</a> : data.image.credit}</figcaption></figure>
    <div class="article-reading-layout container">
      <aside class="article-toc">
        <div class="article-toc__inner">
          {contents.length > 0 && <nav aria-label="In this article"><p>In this article</p><ul>{contents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
          <div class="article-side-cta">
            <p class="article-side-cta__title">Have a question about your policy?</p>
            <p>Send us your declarations page and we’ll review it at no cost.</p>
            <a class="btn btn-primary" href="#article-review">Get a free review</a>
          </div>
        </div>
      </aside>
      <div class="article-reading-main">
        {splitAt > 0 ? (
          <div class="article-prose">
            <Fragment set:html={html.slice(0, splitAt)} />
            <aside class="article-inline-cta" aria-label="Insurance review">
              <div><strong>Renewal in the next 120 days?</strong><span>We’ll compare your current coverage, limits and deductibles against your governing documents at no cost.</span></div>
              <a class="btn btn-gold" href="#article-review">Request Insurance Review</a>
            </aside>
            <Fragment set:html={html.slice(splitAt)} />
          </div>
        ) : (
          <div class="article-prose"><Content /></div>
        )}
        <section class="article-sources" aria-labelledby="article-sources-title"><h2 id="article-sources-title">Sources &amp; further reading</h2><ol>{data.sources.map((source) => <li><a href={source.url} rel="noopener noreferrer">{source.title}</a><span>{source.publisher} · Accessed {articleDate(source.accessedAt)}</span></li>)}</ol></section>
        <p class="article-disclaimer">This article is general information. Coverage depends on the policy, endorsements and facts of the association. Contact a licensed Insurance professional for guidance about your community.</p>

        <section class="article-lead" id="article-review" aria-labelledby="article-lead-title">
          <h2 id="article-lead-title">Get a second opinion on your association’s coverage</h2>
          <p>Our team will review your current policy against your governing documents and flag any gaps at no cost. Any broker fee for a policy is disclosed before purchase.</p>
          <BlogLeadForm variant="review" topic={data.topic} articleTitle={data.title} client:visible />
          <p class="article-lead__alt">Prefer to start online? <a href={cta.href} class="articles-text-link">{cta.label} <span aria-hidden="true">→</span></a></p>
        </section>

        {related.length > 0 && (
          <section class="article-related" aria-labelledby="article-related-title">
            <h2 id="article-related-title">Keep reading</h2>
            <div class="article-related__grid">
              {related.map((other) => (
                <article class="article-card">
                  <a href={articlePath(other.data.slug)} class="article-card__image" tabindex="-1" aria-hidden="true"><img src={other.data.image.src} alt="" width={other.data.image.width} height={other.data.image.height} loading="lazy" /></a>
                  <div class="article-card__body"><p class="articles-eyebrow">{other.data.topic}</p><h3><a href={articlePath(other.data.slug)}>{other.data.title}</a></h3></div>
                </article>
              ))}
            </div>
          </section>
        )}
        <div class="article-end"><a href="/blog/" class="articles-text-link"><span aria-hidden="true">←</span> All articles</a><a href={QUOTE_URL} class="btn btn-primary">Request Insurance Review</a></div>
      </div>
    </div>
  </article>
</Layout>
