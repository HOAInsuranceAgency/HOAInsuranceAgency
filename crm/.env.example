# Sentry configuration targets Master Planning, org ID 4512373753249792.
# Public client DSN from hoainsuranceagency-crm, project ID 4512376858345472.
# Created DSNs are recorded in docs/SENTRY.md; examples stay disabled by default.
# Provision matching build/runtime values and verify staging before production.
# Empty means monitoring is disabled. Never put SENTRY_AUTH_TOKEN in VITE_*.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Build configuration supplies the commit SHA in deployed builds.
VITE_SENTRY_RELEASE=
# Development sends no events unless explicitly enabled for a smoke test.
VITE_SENTRY_ENABLED=false

# Backend DSN from hoainsuranceagency-backend, project ID 4512376864702464.
# Set on the Amplify app; not a browser or secret DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Build-only source-map credentials; never expose the token to a browser/runtime.
# org:ci is organization-wide. Separate app token names support audit/rotation,
# not project-level permission isolation. Provision CRM token record 1218579
# into Amplify build storage only; the record ID is not the token secret.
SENTRY_ORG=master-planning
SENTRY_PROJECT=hoainsuranceagency-crm
SENTRY_AUTH_TOKEN=
