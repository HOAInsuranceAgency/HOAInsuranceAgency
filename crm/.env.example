# Public client DSN from the separate HOA Insurance Agency Sentry organization.
# Empty means monitoring is disabled. Never put SENTRY_AUTH_TOKEN in VITE_*.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Build configuration supplies the commit SHA in deployed builds.
VITE_SENTRY_RELEASE=
# Development sends no events unless explicitly enabled for a smoke test.
VITE_SENTRY_ENABLED=false

# Backend (set on the Amplify app; not a browser or secret DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Build-only credentials for private source maps. Never prefix the token VITE_.
SENTRY_ORG=hoa-insurance-agency
SENTRY_PROJECT=hoa-crm
SENTRY_AUTH_TOKEN=
