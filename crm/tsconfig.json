{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": true
  },
  // `scripts` is here for the same reason `typecheck:backend` exists: a
  // migration script that writes to production data is not less deserving of
  // a type check than a Lambda, and nothing else would ever compile it.
  // `vite build` only reads `src`, so this costs the bundle nothing.
  "include": ["src", "scripts"]
}
