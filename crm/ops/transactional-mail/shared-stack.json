{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "HOA independent transactional email ledger, private payloads and quarantined Resend credentials",
  "Resources": {
    "MailLedger": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "HOA-TransactionalMail",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "Tags": [
          {
            "Key": "Business",
            "Value": "HOA Insurance"
          },
          {
            "Key": "Purpose",
            "Value": "Transactional email safety"
          }
        ]
      }
    },
    "MailPayloads": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": "hoa-transactional-mail-917680434255-us-east-1",
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Business",
            "Value": "HOA Insurance"
          },
          {
            "Key": "Purpose",
            "Value": "Deferred transactional email payloads"
          }
        ]
      }
    },
    "MailPayloadPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "MailPayloads"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "MailPayloads",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${MailPayloads.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "SendingCredential": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "hoa/resend/sending",
        "Description": "HOA Resend domain-scoped sending API key; empty until account verified",
        "SecretString": "{}",
        "Tags": [
          {
            "Key": "Business",
            "Value": "HOA Insurance"
          }
        ]
      }
    },
    "WebhookCredential": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "hoa/resend/webhook",
        "Description": "HOA Resend webhook signing secret; empty until endpoint configured",
        "SecretString": "{}",
        "Tags": [
          {
            "Key": "Business",
            "Value": "HOA Insurance"
          }
        ]
      }
    }
  },
  "Outputs": {
    "MailTable": {
      "Value": {
        "Ref": "MailLedger"
      }
    },
    "MailTableArn": {
      "Value": {
        "Fn::GetAtt": [
          "MailLedger",
          "Arn"
        ]
      }
    },
    "MailBucket": {
      "Value": {
        "Ref": "MailPayloads"
      }
    },
    "SendingSecretArn": {
      "Value": {
        "Ref": "SendingCredential"
      }
    },
    "WebhookSecretArn": {
      "Value": {
        "Ref": "WebhookCredential"
      }
    }
  }
}